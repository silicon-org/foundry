# Every conversion's public header, in one target.
#
# These are declarations only -- a pass constructor and a registration hook per
# conversion -- and they include each other freely: LTLToCore.cpp includes
# HWToSV.h for a declaration it never calls. CMake never notices, because its
# include paths are global. Owning them individually here means a header with no
# target, three times over; owning them together says what is actually true,
# which is that include/circt/Conversion is one interface.
cc_library(
    name = "ConversionHeaders",
    hdrs = [
        "include/circt/Conversion/ExportVerilog.h",
        "include/circt/Conversion/FIRRTLToHW.h",
