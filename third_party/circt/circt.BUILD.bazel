# Split out of :Emit so that :HW can depend on it, which it must: HWOps.h and
# HWOpInterfaces.h include this header, while EmitDialect.h includes HW's
# attributes. CMake does not notice the circularity because its include paths
# are global and it tracks only library-level links, where the edge runs one way
# -- CIRCTEmit links CIRCTHW and not the reverse.
#
# The split is honest rather than a workaround. EmitOpInterfaces.h includes
# circt/Support/LLVM.h, an MLIR header and its own generated .inc, and nothing
# else; it is free-standing precisely so that HW can implement the interface.
cc_library(
    name = "EmitOpInterfaces",
    hdrs = ["include/circt/Dialect/Emit/EmitOpInterfaces.h"],
    includes = ["include"],
    deps = [
        ":EmitOpInterfacesIncGen",
        ":SupportHeaders",
        "@llvm-project//mlir:IR",
    ],
)

