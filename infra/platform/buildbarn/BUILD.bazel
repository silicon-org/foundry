load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# A handful of actions whose only purpose is to exercise the remote cache end
# to end. Not a build -- a probe. Deliberately owned by the cache component
# rather than parked in a scratch package, because when it fails the thing that
# is broken is here.
#
#   bazel build --remote_cache=grpc://localhost:8980 //infra/platform/buildbarn:cache_probe
[
    genrule(
        name = "probe_%d" % i,
        outs = ["probe_%d.txt" % i],
        cmd = "i=0; while [ $$i -lt %d ]; do echo \"probe %d line $$i\"; i=$$((i+1)); done > $@" % (2000, i),
    )
    for i in range(8)
]

filegroup(
    name = "cache_probe",
    srcs = [":probe_%d" % i for i in range(8)],
)

# Exposed so //infra/platform:kustomize_test can render this root. Globs do not
# cross package boundaries.
filegroup(
    name = "manifests",
    srcs = glob([
        "*.yaml",
        "config/*.jsonnet",
        "config/*.libsonnet",
    ]),
    visibility = ["//infra/platform:__pkg__"],
)

# bazel run //infra/platform/buildbarn:tunnel-local
# bazel run //infra/platform/buildbarn:tunnel-hetzner
#
# Opens the ports the matching --config expects and holds them until Ctrl-C.
# The port numbers differ per cluster on purpose: both can be tunnelled at once,
# and a build cannot silently reach the cluster you did not mean.
[
    sh_binary(
        name = "tunnel-" + cluster,
        srcs = ["//infra/platform:tunnel.sh"],
        args = [
            "$(rlocationpath @multitool//tools/kubectl)",
            target,
            cluster,
        ] + specs,
        data = ["@multitool//tools/kubectl"],
        env = {"TUNNEL_HINT": "Build with --config=" + cluster + "-dev."},
        deps = ["@bazel_tools//tools/bash/runfiles"],
    )
    for cluster, target, specs in [
        (
            "local",
            "admin@foundry-3",
            [
                "buildbarn/frontend-rw:8980:8980",
                "buildbarn/remote-asset:8985:8985",
            ],
        ),
        (
            "hetzner",
            "infra/talos/clusterconfig/kubeconfig",
            [
                "buildbarn/frontend-rw:8990:8980",
                "buildbarn/remote-asset:8991:8985",
                "bb-portal/bb-portal:8081:8081",
                "bb-portal/bb-portal:8082:8082",
            ],
        ),
    ]
]
