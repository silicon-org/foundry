# Fail loudly rather than silently falling back to a non-hermetic host tool.
build --incompatible_strict_action_env

# Locally, dependency edits update MODULE.bazel.lock; in CI a stale lockfile is
# an error rather than something a build silently rewrites.
common --lockfile_mode=update
common:ci --lockfile_mode=error

# Readable failures.
common --color=yes
build --verbose_failures
test --test_output=errors

# Remote execution / caching against our own Buildbarn, filled in once the
# cluster exists. Untrusted builds must use the read-only frontend: they may
# read the Action Cache but never write it. See infra/platform/buildbarn/.
#
# Remote execution against the in-cluster Buildbarn. The endpoint is a
# port-forward locally and a service name in CI, so it is passed on the command
# line rather than pinned here.
# All three are needed, not just the first. --extra_execution_platforms alone
# leaves the host platform ahead of ours in exec selection, so tool actions get
# built for the host with no exec_properties -- which the scheduler reports as
# "no workers exist for platform {}", a long way from the cause.
build:remote --extra_execution_platforms=//platforms:linux_arm64
build:remote --host_platform=//platforms:linux_arm64
build:remote --platforms=//platforms:linux_arm64
build:remote --jobs=50

# The cloud cluster, which is x86 rather than arm64 because that is what Hetzner
# had. Same three flags for the same reason; only the architecture differs.
#
# Deliberately a separate config rather than a variable in the one above: the
# two clusters have different caches and different action digests, and a flag
# that silently changed which one you were talking to would be a bad way to
# find that out.
build:hetzner --extra_execution_platforms=//platforms:linux_amd64
build:hetzner --host_platform=//platforms:linux_amd64
build:hetzner --platforms=//platforms:linux_amd64
build:hetzner --jobs=50

# Verilator's lint pass over every design that declares a top module:
#
#   bazel build --config=lint //hardware/...
#
# An aspect rather than a target, so that a design is checked because it is a
# design and not because somebody remembered to write a rule for it. Libraries
# without a top module -- parameterised cells, generated collections of modules --
# cannot be elaborated in isolation and are skipped, which is why the design that
# instantiates them is where the check lands.
build:lint --aspects=@rules_verilator//verilator:defs.bzl%verilator_lint_aspect
build:lint --output_groups=verilator_lint_checks

# Developer shorthands: platform, endpoints and build UI in one flag, so none
# of it has to be remembered or retyped.
#
#   bazel run //infra/platform/buildbarn:tunnel-hetzner    # in one terminal
#   bazel test --config=hetzner-dev //...                  # in another
#
# Layered over the platform-only configs above rather than folded into them,
# because CI passes in-cluster service addresses and must not inherit a
# localhost endpoint that happens to be forwarded to the wrong cluster.
build:local-dev --config=remote
build:local-dev --remote_executor=grpc://localhost:8980
build:local-dev --experimental_remote_downloader=grpc://localhost:8985

build:hetzner-dev --config=hetzner
build:hetzner-dev --remote_executor=grpc://localhost:8990
build:hetzner-dev --experimental_remote_downloader=grpc://localhost:8991
# Build results in the portal, and a URL printed for every invocation.
build:hetzner-dev --bes_backend=grpc://localhost:8082
build:hetzner-dev --bes_results_url=http://localhost:8081/bes/

# An LLVM toolchain has no libatomic, but Verilator and rules_verilator both
# pass -latomic on Linux. This links an empty one into every binary so the flag
# resolves. See //third_party/libatomic for why that is sound.
build --@bazel_tools//tools/cpp:link_extra_libs=//third_party/libatomic:atomic

# Downloads go through the cluster's asset service rather than out to the
# internet from every client. Remote execution moves actions but not repository
# rules, so without this each runner re-fetches the whole external graph -- and
# the hermetic toolchain made that graph large.
#
# The endpoint is a port-forward locally and a service name in CI, so it is
# passed on the command line like the executor.
#
# --experimental_remote_downloader_local_fallback is deliberately NOT set. With
# it, an unreachable or unauthorised asset service silently becomes a direct
# download, which is exactly the behaviour the runner allow-list is meant to
# prevent; better that the build fails and says so.

# Developer-local overrides; never committed.
try-import %workspace%/.bazelrc.user
