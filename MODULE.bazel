"""foundry: hardware designs plus the infrastructure that builds them."""

module(
    name = "foundry",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.16")

# A C++ toolchain that targets Linux regardless of what machine runs Bazel.
#
# Without one, remote execution fails during analysis rather than on a worker:
# Bazel's autodetected toolchain only ever targets the host, so asking for a
# linux/arm64 execution platform finds no toolchain at all. Verilator makes that
# concrete, being several thousand C++ actions built from source.
#
# hermetic-llvm cross-compiles the target-specific pieces -- libc, libc++,
# compiler-rt -- from source instead of requiring a sysroot per target. That
# matters twice over: cross-compiling from a Mac needs no Linux rootfs, and the
# toolchain is hermetic enough to ship to workers through the CAS. The compiler
# version ends up in the build graph rather than baked into a worker image that
# nobody diffs.
bazel_dep(name = "llvm", version = "0.8.17")

# Only the combinations we actually build: from a developer Mac or a Linux
# runner, onto Linux workers of either architecture.
#
# Both Linux targets are registered because the two clusters differ: the local
# one is Talos in Docker on Apple Silicon, so arm64, and the Hetzner one is x86
# because that is what could be bought. Cross-compiling to either from the same
# Mac is the entire reason for a zero-sysroot toolchain -- without it, adding
# x86 would have meant finding a Linux machine to build on.
llvm_toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchain.exec(arch = "aarch64", os = "macos")
llvm_toolchain.exec(arch = "aarch64", os = "linux")
llvm_toolchain.exec(arch = "x86_64", os = "linux")
llvm_toolchain.target(arch = "aarch64", os = "linux")
llvm_toolchain.target(arch = "x86_64", os = "linux")
use_repo(llvm_toolchain, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

bazel_dep(name = "rules_shell", version = "0.8.0")

# Hardware. rules_verilator drives Verilator; rules_verilog provides the
# verilog_library that describes a design's sources and its top module.
bazel_dep(name = "rules_verilator", version = "1.1.2")
bazel_dep(name = "rules_verilog", version = "1.4.2")

register_toolchains("@rules_verilator//verilator:verilator_toolchain")

# Third-party IP is pinned by hash rather than vendored into this history. The
# BUILD file that makes it a Bazel target lives with us, in
# //hardware/ip/common_cells, because it is our integration and not upstream's.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "common_cells",
    build_file = "//hardware/ip/common_cells:common_cells.BUILD.bazel",
    sha256 = "df7e2086e59d144ccd9bee2196778fdf23dfec803affd0273c6f69f56c5f5b46",
    # Anchors the include search path. rules_verilog derives -I from each
    # header's directory, but its `includes` attribute is computed from
    # ctx.label.package and ignores an external repository's root, so it emits a
    # bare "-Iinclude" that resolves against the wrong tree. Cells include
    # "common_cells/assertions.svh", so the search path has to be include/ --
    # and an empty header sitting there produces exactly that. Worth upstreaming.
    patch_cmds = ["touch include/_incdir_anchor.svh"],
    strip_prefix = "common_cells-2.0.0-beta.3",
    url = "https://github.com/pulp-platform/common_cells/archive/refs/tags/v2.0.0-beta.3.tar.gz",
)

# XiangShan. What is pinned here is the *generator*, not RTL: the SystemVerilog
# is a build output of this graph like any object file.
#
# Chisel is a Scala library, so generating XiangShan is compiling Scala and
# running a JVM program. That is why this is rules_scala plus pinned jars rather
# than an attempt to make mill hermetic -- mill is upstream's build tool, not
# part of the design. //hardware/ip/xiangshan mirrors the module graph in
# upstream's build.mill; the jars below mirror its ivyDeps.
bazel_dep(name = "rules_scala", version = "7.2.6")
bazel_dep(name = "rules_jvm_external", version = "7.1")

# 2.13.18 where upstream's build.mill says 2.13.17. rules_scala carries compiler
# jar hashes for a fixed set of versions and 2.13.17 is not among them, so the
# alternative is pinning three more jars by hand to gain one patch release.
# Chisel publishes its compiler plugin for every 2.13.x, so nothing else moves.
scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(scala_version = "2.13.18")

scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()

# Ahead of the toolchain rules_scala registers itself, because upstream's sources
# expect a transitive compile classpath. See //hardware/ip/xiangshan:BUILD.bazel.
register_toolchains("//hardware/ip/xiangshan:transitive_classpath")

# Chisel and the few libraries build.mill asks for, resolved once into a lock
# file. Unpinned this would be a coursier download at build time that no review
# ever sees; `REPIN=1 bazel run @xs_maven//:pin` is how it moves.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "xs_maven",
    artifacts = [
        "org.chipsalliance:chisel_2.13:7.13.0",
        "org.chipsalliance:chisel-plugin_2.13.18:7.13.0",
        "com.lihaoyi:sourcecode_2.13:0.4.4",
        "com.lihaoyi:mainargs_2.13:0.7.7",
        "org.json4s:json4s-jackson_2.13:4.0.7",
        "org.scala-lang:scala-reflect:2.13.18",
        "io.circe:circe-yaml_2.13:0.16.1",
        "io.circe:circe-generic-extras_2.13:0.14.4",
        # Not for testing. A handful of files under upstream's src/main hold
        # scalatest specs next to the hardware they check, so the core does not
        # compile without it.
        "org.scalatest:scalatest_2.13:3.2.19",
    ],
    lock_file = "//hardware/ip/xiangshan:maven_install.json",
)
use_repo(maven, "xs_maven")

# The generator's Scala sources. Upstream keeps them in eight submodules of
# XiangShan plus two nested ones, and a submodule is a commit, so each becomes
# its own archive pinned at exactly the commit the XiangShan tree names. That
# also leaves out `ready-to-run`, a gigabyte of simulator binaries that a
# recursive clone would drag in and that RTL generation never reads.
#
# All ten are at the commits recorded by XiangShan a7fc87df on the kunminghu-v3
# branch. There is no release to track: upstream's newest tag predates this
# source layout by two years.
http_archive(
    name = "xiangshan",
    build_file = "//hardware/ip/xiangshan:xiangshan.BUILD.bazel",
    # Two of the resources mill produces by shelling out to git during the
    # build, and that elaboration reads back: the version string that lands in
    # the device tree, and the commit that lands in a CSR. Writing them here
    # from the pin above is what makes generation reproducible -- mill's
    # versions carry the builder's username, hostname and a timestamp.
    patch_cmds = [
        "printf 'KunminghuV3-a7fc87df' > src/main/resources/publishVersion",
        "printf 'SHA=a7fc87df1e82211eb47f3c74a8c93cd9d425572b\\ndirty=0\\n' > src/main/resources/gitStatus",
    ],
    sha256 = "935e9dfec81e5b1e8974c060a59bf0a5e7309cf3dba9233b7f5ae3676ac13d20",
    strip_prefix = "XiangShan-a7fc87df1e82211eb47f3c74a8c93cd9d425572b",
    url = "https://github.com/OpenXiangShan/XiangShan/archive/a7fc87df1e82211eb47f3c74a8c93cd9d425572b.tar.gz",
)

