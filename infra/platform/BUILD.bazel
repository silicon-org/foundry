load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Shared by the tunnel targets in buildbarn/ and monitoring/. See tunnel.sh.
exports_files(["tunnel.sh"])

# Every directory holding a kustomization.yaml. Flux renders these at reconcile
# time; this renders them at commit time, where a failure is attached to the
# change that caused it.
KUSTOMIZE_ROOTS = [
    "infra/platform/arc",
    "infra/platform/buildbarn",
    "infra/platform/cilium",
    "infra/platform/clusters/local",
    "infra/platform/clusters/local/buildbarn",
    "infra/platform/hcloud",
    "infra/platform/bb-portal",
    "infra/platform/clusters/hetzner/buildbarn",
    "infra/platform/clusters/hetzner/cilium",
    "infra/platform/clusters/hetzner/arc",
    "infra/platform/clusters/hetzner",
    "infra/platform/clusters/local/arc",
    "infra/platform/monitoring",
]

# Every PrometheusRule in the tree. Listed rather than globbed so that a file
# added to monitoring/rules/ and forgotten here fails review rather than
# silently going unchecked.
PROMETHEUS_RULES = [
    "infra/platform/monitoring/rules/arc.yaml",
    "infra/platform/monitoring/rules/buildbarn.yaml",
    "infra/platform/monitoring/rules/capacity.yaml",
    "infra/platform/monitoring/rules/cilium.yaml",
    "infra/platform/monitoring/rules/flux.yaml",
]

sh_test(
    name = "promtool_test",
    size = "small",
    srcs = ["promtool_test.sh"],
    args = ["$(rlocationpath @multitool//tools/promtool)"] + PROMETHEUS_RULES,
    data = [
        "@multitool//tools/promtool",
        "//infra/platform/monitoring:manifests",
    ],
)

sh_test(
    name = "kustomize_test",
    size = "small",
    srcs = ["kustomize_test.sh"],
    args = ["$(rlocationpath @multitool//tools/kubectl)"] + KUSTOMIZE_ROOTS,
    data = [
        "@multitool//tools/kubectl",
        "//infra/platform/buildbarn:manifests",
        "//infra/platform/cilium:manifests",
        "//infra/platform/hcloud:manifests",
        "//infra/platform/bb-portal:manifests",
        "//infra/platform/monitoring:manifests",
    ] + glob(["**/*.yaml"]),
)
