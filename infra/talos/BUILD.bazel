load("//tools:workspace_command.bzl", "workspace_command")

# The local cluster runs Talos in Docker. Talos' Docker provisioner generates
# machine configs itself, so talhelper -- which generates but does not
# provision -- has nothing to do here. The patches are the shared part, and
# talhelper consumes the same files for cloud machines.
CLUSTER = "foundry"

# Matches what this Talos release is tested against. The pinned kubectl (1.36.3)
# is one patch ahead, which is well inside the supported skew.
KUBERNETES_VERSION = "1.36.2"

# bazel run //infra/talos:up
workspace_command(
    name = "up",
    args = [
        "cluster",
        "create",
        "docker",
        "--name",
        CLUSTER,
        "--kubernetes-version",
        KUBERNETES_VERSION,
        "--workers",
        "1",
        # Sized deliberately, because the defaults are 2 CPUs and 2GiB per node
        # and nothing in Kubernetes will tell you that.
        #
        # A Talos node here is a container with a cgroup limit, but Talos reads
        # the host's /proc/meminfo, so the kubelet advertises the whole Docker
        # VM's memory as node capacity. Scheduling decisions are therefore made
        # against a number an order of magnitude larger than the node can
        # actually use, and the usual protections never engage: nothing is
        # evicted and MemoryPressure stays False, because by the kubelet's
        # arithmetic there is plenty free.
        #
        # What that looks like when it bites is not an OOM kill. It is every
        # workload on the node degrading at once -- the Cilium agent failing its
        # liveness probe, CoreDNS refusing connections on :53, Flux controllers
        # killed -- and a build failing far away with "Unknown host" on a domain
        # that is definitely allow-listed. Then it recovers cleanly the moment
        # the load stops, which makes it read like a network fault rather than
        # exhaustion.
        #
        # The worker gets the larger share: it runs the CI runner and the
        # Buildbarn worker, and the runner alone is capped at 3GiB, which
        # exceeded a whole default-sized node. Sized to leave the Mac room
        # rather than to fill it -- 14 GiB of the VM's 23.4, 10 CPUs of 14.
        "--memory-controlplanes",
        "4gb",
        "--cpus-controlplanes",
        "2.0",
        "--memory-workers",
        "10gb",
        "--cpus-workers",
        "8.0",
        "--config-patch",
        "@patches/base.yaml",
        "--config-patch",
        "@patches/local.yaml",
    ],
    tool = "@multitool//tools/talosctl",
    workdir = "infra/talos",
)

# bazel run //infra/talos:down
workspace_command(
    name = "down",
    args = [
        "cluster",
        "destroy",
        "--name",
        CLUSTER,
    ],
    tool = "@multitool//tools/talosctl",
    workdir = "infra/talos",
)

# bazel run //infra/talos:kubeconfig -- --force
# Merges the cluster's credentials into ~/.kube/config.
workspace_command(
    name = "kubeconfig",
    args = [
        "kubeconfig",
        "--nodes",
        "10.5.0.2",
    ],
    tool = "@multitool//tools/talosctl",
    workdir = "infra/talos",
)
