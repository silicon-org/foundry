load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

verilog_library(
    name = "xs_cluster_tb",
    srcs = ["xs_cluster_tb.sv"],
    hdrs = [
        "//hardware/vip/chi:chi_hn_dpi_svh",
        "//hardware/vip/common:vip_dpi_svh",
    ],
    top_module = "xs_cluster_tb",
    deps = [
        "//hardware/soc/xs_cluster",
        "//hardware/vip/chi/rtl:chi_hn_agent",
    ],
)

# Shared so the traced and untraced models cannot drift apart.
VOPTS = [
    # The generated RTL warns in thousands of places and none of it is ours
    # to fix. The design that matters here is the wrapper, and
    # `bazel build --config=lint //hardware/...` is where that is checked.
    "-Wno-fatal",
    # Without this, Verilator emits a handful of C++ files of a size that
    # makes the compiler the bottleneck and, on a smaller machine, makes it
    # run out of memory. Splitting costs nothing at this scale.
    "--output-split",
    "20000",
    "--output-split-cfuncs",
    "20000",
    # Verilator writes main() and the --timing loop, so no C++ lives here and the
    # testbench is portable SystemVerilog. It decides no verdict, though, so the
    # testbench asks vip_test_failed() and calls $fatal itself.
    "--main",
    # One default timescale for every module. The generated RTL declares
    # none, and a design whose time precision depends on which file
    # Verilator saw first is a design whose clock period does too.
    "--timescale",
    "1ns/1ps",
]

# The expensive one. 139 MB of generated SystemVerilog across 1868 modules, and
# --timing on top of it because the clock lives in the testbench.
verilator_cc_library(
    name = "xs_cluster_verilated",
    module = ":xs_cluster_tb",
    timing = True,
    vopts = VOPTS,
)

# Deliberately not `manual`: a testbench nobody runs is a testbench that stops
# working. `exclusive` because several copies of a model this size will exhaust a
# worker's memory, and the fast loop for everything else is
# `bazel test //hardware/ip/... //hardware/vip/...`.
cc_test(
    name = "xs_cluster_tb_test",
    size = "enormous",
    tags = ["exclusive"],
    deps = [
        ":xs_cluster_verilated",
        "//hardware/vip/chi:chi_hn_dpi",
        "//hardware/vip/common:verilated_shims",
        "//hardware/vip/common:vip_dpi",
    ],
)

########################################################################################################
# The same testbench, with waveforms
#
# A second model rather than a flag, so tracing never slows the test above.
# FST because that is what tsunami reads; see //tools/README.md.
#
#   bazel run //hardware/soc/xs_cluster/tb:xs_cluster_tb_traced -- \
#       +dump +dumpfile=/tmp/xs.fst
#
# A cc_binary, not a cc_test: the target above is what CI runs.
########################################################################################################

verilator_cc_library(
    name = "xs_cluster_verilated_traced",
    module = ":xs_cluster_tb",
    # Built on request, never by `//...`, and that is a memory bound rather than
    # tidiness. Verilating this model is a single process over 139 MB of
    # SystemVerilog and it needs more than 16 GiB on its own; the traced variant
    # needs more still. `bazel test //...` builds every target in the pattern,
    # not only the tests, so without this the worker is asked to run both at
    # once -- which no limit the node can offer will satisfy, and it fails as
    # "dial unix /worker/runner: connection refused" from the container that
    # survived.
    #
    # Nothing is lost: this exists for `bazel run ... -- +dump`, which names it
    # explicitly.
    tags = ["manual"],
    timing = True,
    trace_mode = "fst",
    vopts = VOPTS,
)

cc_binary(
    name = "xs_cluster_tb_traced",
    # Same reason as the library it wraps.
    tags = ["manual"],
    deps = [
        ":xs_cluster_verilated_traced",
        "//hardware/vip/chi:chi_hn_dpi",
        "//hardware/vip/common:verilated_shims",
        "//hardware/vip/common:vip_dpi",
    ],
)
