# Bazel view of CIRCT. Overlaid onto the fetched archive by the http_archive in
# //MODULE.bazel.
#
# CIRCT's own build is CMake and upstream has declined to carry a Bazel one, so
# everything here is a transcription of the CMakeLists files in the tree this is
# laid over. Where a target looks arbitrary, the CMake file next to the sources
# is the authority; where this file departs from it, there is a comment saying
# why.
#
# Scope is the firtool closure and nothing else: 33 libraries over 11 dialects,
# derived by walking LINK_LIBS out from the thirteen libraries
# tools/firtool/CMakeLists.txt names. CIRCT has 32 dialects in all, and the ones
# left out -- Arc, Calyx, ESI, Handshake, Moore and the rest -- are absent
# because nothing here builds them, not because they are hard.
#
# One file rather than a tree of them. The alternative was LLVM's arrangement, a
# directory of BUILD files symlinked over the sources by a repository rule,
# which buys per-directory diffs against upstream at the cost of a vendored copy
# of a private LLVM helper and a solution to the problem that BUILD files under
# //third_party would also be loaded as packages of this repository. The
# repository already overlays twelve archives with a single file each.

load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@foundry//third_party/circt:defs.bzl", "circt_dialect", "circt_interface", "circt_tablegen")
load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

#-------------------------------------------------------------------------------
# TableGen inputs
#-------------------------------------------------------------------------------

# Every .td file CIRCT ships, as one dependency.
#
# MLIR splits its own .td files into a hundred fine-grained td_library targets,
# and for MLIR that is right: it is enormous and its .td files change daily, so
# a narrow dependency is the difference between regenerating one header and
# regenerating all of them. Neither applies here. This tree arrives frozen by an
# http_archive pin and changes only when that pin moves, at which point every
# generated header is stale anyway.
#
# It also sidesteps a real problem. Seq and Sim include each other's type
# definitions -- SeqOps.td includes Sim/SimTypes.td while SimOps.td includes
# Seq/SeqTypes.td -- so a td_library per dialect would be a dependency cycle,
# and breaking it means splitting each dialect's types away from its operations
# for no benefit that survives the paragraph above.
td_library(
    name = "CIRCTTdFiles",
    srcs = glob([
        "include/circt/**/*.td",
        # Not all of them live under include/. lib/Dialect/FIRRTL holds the
        # intrinsics *table*, which upstream's own comment distinguishes from
        # the identically named ops file under include/ -- two files, one
        # basename, different trees.
        "lib/**/*.td",
    ]),
    includes = ["include"],
    deps = [
        "@llvm-project//mlir:BuiltinDialectTdFiles",
        "@llvm-project//mlir:CallInterfacesTdFiles",
        "@llvm-project//mlir:ControlFlowInterfacesTdFiles",
        "@llvm-project//mlir:EmitCTdFiles",
        "@llvm-project//mlir:FunctionInterfacesTdFiles",
        "@llvm-project//mlir:InferIntRangeInterfaceTdFiles",
        "@llvm-project//mlir:InferTypeOpInterfaceTdFiles",
        "@llvm-project//mlir:MemorySlotInterfacesTdFiles",
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:PassBaseTdFiles",
        "@llvm-project//mlir:RewritePassBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
    ],
)

#-------------------------------------------------------------------------------
# Support
#-------------------------------------------------------------------------------

# What CMake generates by asking git for the newest matching tag, and what the
# emitted SystemVerilog carries in its header comment.
#
# Written from the pin rather than discovered, for the reason //MODULE.bazel
# gives for XiangShan's publishVersion: a version derived from the builder's
# working copy is a version that differs per builder. `firtool-1.149.0` is what
# `git describe --tags --match 'firtool*'` produces at the pinned commit.
expand_template(
    name = "version_cpp",
    out = "lib/Support/Version.cpp",
    substitutions = {"@CIRCT_VERSION@": "firtool-1.149.0"},
    template = "lib/Support/Version.cpp.in",
)

cc_library(
    name = "Version",
    srcs = [":version_cpp"],
    hdrs = ["include/circt/Support/Version.h"],
    includes = ["include"],
)

# circt-tblgen needs circt/Support/LLVM.h, which is a set of using-declarations
# pulling LLVM and MLIR names into the circt namespace and nothing else. Kept
# apart from :Support so that generating a dialect's headers does not depend on
# compiling the library those headers are for.
cc_library(
    name = "SupportHeaders",
    hdrs = ["include/circt/Support/LLVM.h"],
    includes = ["include"],
    deps = [
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
    ],
)

circt_interface(
    name = "InstanceGraphInterface",
    dir = "Support",
)

cc_library(
    name = "Support",
    srcs = glob(
        [
            "lib/Support/*.cpp",
            "lib/Support/*.h",
        ], allow_empty = True),
    hdrs = glob(["include/circt/Support/*.h"]),
    includes = ["include"],
    deps = [
        ":InstanceGraphInterfaceIncGen",
        ":Version",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:TransformUtils",
        "@llvm-project//mlir:Transforms",
    ],
)


# What every dialect here needs from MLIR, as reported by the mlir/ headers its
# sources include rather than by guesswork. Named once because eleven copies of
# the same nine labels is nine chances to let one drift.
MLIR_DIALECT_DEPS = [
    "@llvm-project//llvm:Support",
    "@llvm-project//mlir:BytecodeOpInterface",
    "@llvm-project//mlir:IR",
    "@llvm-project//mlir:InferTypeOpInterface",
    "@llvm-project//mlir:SideEffectInterfaces",
    "@llvm-project//mlir:Support",
]

# CIRCT's own tablegen backends, on top of MLIR's.
#
# Needed for exactly three generated files in the firtool closure, all FIRRTL:
# the annotation details and records headers under include/, and
# FIRRTLIntrinsics.cpp.inc under lib/. The RTG backends compiled in alongside
# them belong to a dialect nothing here builds, but they are in the same binary
# upstream and splitting them would be a fork of the tool rather than a
# transcription of it.
cc_binary(
    name = "circt-tblgen",
    srcs = glob([
        "tools/circt-tblgen/*.cpp",
        "tools/circt-tblgen/*.h",
    ]),
    deps = [
        ":SupportHeaders",
        ":Version",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:TableGen",
        "@llvm-project//mlir:MlirTableGenMain",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:TableGen",
    ],
)

