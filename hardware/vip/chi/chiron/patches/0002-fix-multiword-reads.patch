@@ -461,6 +461,21 @@
                     assert(index * 32 + offset == width);
                 }
             };
+
+            /*
+            Read a field wider than 32 bits, low word first.
+
+            The obvious spelling -- Walk32() | (Walk32() << 32) -- leaves the two calls
+            unsequenced, so which half of the field each one returns is up to the
+            compiler. Splitting it into two statements is what makes the order part of
+            the program rather than of the build.
+            */
+            inline uint64_t Walk64(FlitWalker& walker, size_t hiWidth = 32) noexcept
+            {
+                uint64_t lo = walker.Walk32();
+                uint64_t hi = walker.Walk32(hiWidth);
+                return lo | (hi << 32);
+            }
             
