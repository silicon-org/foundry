# AMBA CHI, Issue E.b.
#
# Ours rather than third-party, despite sitting under ip/: it is a description
# of a specification, shared by the designs that speak CHI and the agents that
# verify them, and it belongs to neither of them. See README.md.

load("@rules_verilog//verilog:defs.bzl", "verilog_library")

package(default_visibility = ["//visibility:public"])

# No top_module, so the lint aspect passes over this and checks it where it is
# instantiated instead. A package has nothing to elaborate.
verilog_library(
    name = "chi_pkg",
    srcs = ["src/chi_pkg.sv"],
    hdrs = ["include/chi_typedef.svh"],
)

# The link layer: L-Credit flow control and the LINKACTIVE handshake, and
# nothing about what a flit means.
#
# Written for //hardware/vip/chi, which said at the time that these were
# "synthesisable in shape, so the same module can front real RTL later". Later
# arrived: //hardware/ip/chi_noc builds every crosspoint port out of them, so
# they belong beside the specification they implement rather than beside one of
# their two users.
#
# Parameterised library modules, so no top_module -- the lint aspect cannot
# elaborate one in isolation, and //hardware/vip/chi/test is where the pair is
# wired to itself and run.
verilog_library(
    name = "chi_link",
    srcs = [
        "src/chi_link_activation_ack.sv",
        "src/chi_link_activation_req.sv",
        "src/chi_link_rx_channel.sv",
        "src/chi_link_tx_channel.sv",
    ],
    deps = [":chi_pkg"],
)
