load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Exposed so //infra/platform:kustomize_test can render this root. Globs do not
# cross package boundaries, and the dashboards are JSON rather than YAML, so the
# test's own glob would not pick them up.
filegroup(
    name = "manifests",
    srcs = glob([
        "*.yaml",
        "observe/*.yaml",
        "observe/scrape/*.yaml",
        "observe/rules/*.yaml",
        "dashboards/*.json",
    ]),
    visibility = ["//infra/platform:__pkg__"],
)

# bazel run //infra/platform/monitoring:tunnel-hetzner
#
# Prometheus and Alertmanager on localhost, for as long as it runs. Grafana is
# here too but no longer needs to be: it is on the tailnet at
# https://grafana.pogona-gila.ts.net -- see ingress.yaml.
#
# The other two are deliberately not published. Grafana authenticates; Prometheus
# and Alertmanager do not, so exposing them would put an unauthenticated read of
# every metric in the cluster in front of anyone on the tailnet. They are also
# reached rarely and by an administrator, which is exactly the case a tunnel
# suits. If that changes, publish them behind the operator with auth in front,
# not by adding two more entries here.
#
# Ports deliberately clear of the buildbarn tunnel's, so both can run at once.
sh_binary(
    name = "tunnel-hetzner",
    srcs = ["//infra/platform:tunnel.sh"],
    args = [
        "$(rlocationpath @multitool//tools/kubectl)",
        "infra/talos/clusterconfig/kubeconfig",
        "hetzner",
        "monitoring/kube-prometheus-stack-grafana:3000:80",
        "monitoring/kube-prometheus-stack-prometheus:9090:9090",
        "monitoring/kube-prometheus-stack-alertmanager:9093:9093",
    ],
    env = {"TUNNEL_HINT": "Prometheus on http://localhost:9090, Alertmanager on http://localhost:9093. Grafana is on the tailnet: https://grafana.pogona-gila.ts.net"},
    data = ["@multitool//tools/kubectl"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
