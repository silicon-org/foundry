load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools:workspace_command.bzl", "workspace_command")

# The local cluster runs Talos in Docker. Talos' Docker provisioner generates
# machine configs itself, so talhelper -- which generates but does not
# provision -- has nothing to do here. The patches are the shared part, and
# talhelper consumes the same files for cloud machines.
CLUSTER = "foundry"

# Matches what this Talos release is tested against. The pinned kubectl (1.36.3)
# is one patch ahead, which is well inside the supported skew.
KUBERNETES_VERSION = "1.36.2"

# Must equal the pinned talosctl in //tools -- `bazel run //tools:versions`
# prints both. The local provisioner takes the version from the talosctl binary
# itself, so this only names it for the cloud image, where the version is part
# of a URL rather than implied by a tool.
TALOS_VERSION = "v1.13.8"

# Where the image is built, and on what. The snapshot is project-wide, so these
# govern only the throwaway server that writes it, not where the cluster runs.
#
# Both are stated rather than defaulted, because the uploader picks cax11 in
# fsn1 on its own and reports the consequence as "unsupported location for
# server type" -- an error naming neither the type it chose nor the real reason,
# which is that Hetzner says "unsupported" when a type is simply out of stock
# there. That cost an afternoon.
#
# The server type must be the SMALLEST one any node in the cluster uses, which
# is a rule about disks rather than about cores. A Hetzner snapshot inherits the
# disk size of the machine it was taken from and cannot shrink, so an image
# built on a big instance is unusable on a smaller one -- reported at apply time
# as "image disk is bigger than server type disk", which describes the symptom
# without hinting that the cause is where the snapshot was made.
#
# cx23 has a 40 GB disk against ccx13's 80 and ccx33's 240, so building here
# produces an image every node can boot. Raise this only in step with the
# smallest node type, never independently.
LOCATION = "fsn1"

SERVER_TYPE = "cx23"

# bazel run //infra/talos:up
workspace_command(
    name = "up",
    args = [
        "cluster",
        "create",
        "docker",
        "--name",
        CLUSTER,
        "--kubernetes-version",
        KUBERNETES_VERSION,
        "--workers",
        "1",
        # Sized deliberately, because the defaults are 2 CPUs and 2GiB per node
        # and nothing in Kubernetes will tell you that.
        #
        # A Talos node here is a container with a cgroup limit, but Talos reads
        # the host's /proc/meminfo, so the kubelet advertises the whole Docker
        # VM's memory as node capacity. Scheduling decisions are therefore made
        # against a number an order of magnitude larger than the node can
        # actually use, and the usual protections never engage: nothing is
        # evicted and MemoryPressure stays False, because by the kubelet's
        # arithmetic there is plenty free.
        #
        # What that looks like when it bites is not an OOM kill. It is every
        # workload on the node degrading at once -- the Cilium agent failing its
        # liveness probe, CoreDNS refusing connections on :53, Flux controllers
        # killed -- and a build failing far away with "Unknown host" on a domain
        # that is definitely allow-listed. Then it recovers cleanly the moment
        # the load stops, which makes it read like a network fault rather than
        # exhaustion.
        #
        # The worker gets the larger share: it runs the CI runner and the
        # Buildbarn worker, and the runner alone is capped at 3GiB, which
        # exceeded a whole default-sized node. Sized to leave the Mac room
        # rather than to fill it -- 14 GiB of the VM's 23.4, 10 CPUs of 14.
        "--memory-controlplanes",
        "4gb",
        "--cpus-controlplanes",
        "2.0",
        "--memory-workers",
        "10gb",
        "--cpus-workers",
        "8.0",
        "--config-patch",
        "@patches/base.yaml",
        "--config-patch",
        "@patches/local.yaml",
    ],
    tool = "@multitool//tools/talosctl",
    workdir = "infra/talos",
)

# bazel run //infra/talos:down
workspace_command(
    name = "down",
    args = [
        "cluster",
        "destroy",
        "--name",
        CLUSTER,
    ],
    tool = "@multitool//tools/talosctl",
    workdir = "infra/talos",
)

# bazel run //infra/talos:image
#
# Prints the Hetzner snapshot ID for the image described by schematic.yaml,
# building it first if it does not exist yet. Feed it to tofu as
# -var="talos_snapshot_id=...".
sh_binary(
    name = "image",
    srcs = ["image.sh"],
    args = [
        "$(rlocationpath @multitool//tools/hcloud)",
        "$(rlocationpath @multitool//tools/hcloud-upload-image)",
        TALOS_VERSION,
        LOCATION,
        SERVER_TYPE,
    ],
    data = [
        "@multitool//tools/hcloud",
        "@multitool//tools/hcloud-upload-image",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# bazel run //infra/talos:genconfig
#
# Renders per-node machine configs from talconfig.yaml into clusterconfig/,
# which is gitignored: they contain cluster secrets in the clear. The encrypted
# talsecret.sops.yaml is the committed half, and it is what makes this
# reproducible rather than a one-time event.
workspace_command(
    name = "genconfig",
    args = ["genconfig"],
    tool = "@multitool//tools/talhelper",
    workdir = "infra/talos",
)

# bazel run //infra/talos:validate
#
# Checks talconfig.yaml without needing secrets, a cluster, or a network.
workspace_command(
    name = "validate",
    args = [
        "validate",
        "talconfig",
        "talconfig.yaml",
    ],
    tool = "@multitool//tools/talhelper",
    workdir = "infra/talos",
)

# bazel run //infra/talos:kubeconfig -- --force
# Merges the cluster's credentials into ~/.kube/config.
workspace_command(
    name = "kubeconfig",
    args = [
        "kubeconfig",
        "--nodes",
        "10.5.0.2",
    ],
    tool = "@multitool//tools/talosctl",
    workdir = "infra/talos",
)
