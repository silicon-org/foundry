# A CHI mesh: crosspoints, routing, and the generator that wires them up.
#
# See README.md for the architecture. The RTL arrives in M2; what is here now is
# the generator and a topology generated by it, which is enough to check that a
# description produces the netlist it should.

load("@rules_verilog//verilog:defs.bzl", "verilog_library")
load("//hardware/ip/chi_noc:defs.bzl", "nocgen_topology")

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

# The fabric's own structure: ports, NodeID, routing. No CHI dependency, which
# is what lets the crosspoint be built and tested without one.
verilog_library(
    name = "chi_noc_pkg",
    srcs = ["src/chi_noc_pkg.sv"],
)

# Where the CHI issue enters, and the only place it does.
verilog_library(
    name = "chi_noc_flit_pkg",
    srcs = ["src/chi_noc_flit_pkg.sv"],
    deps = ["//hardware/ip/chi:chi_pkg"],
)

# The crosspoint. No top_module: these are parameterised library modules and the
# lint aspect cannot elaborate one in isolation, so //hardware/ip/chi_noc/test is
# where their parameters are fixed and they are run.
verilog_library(
    name = "chi_xp",
    srcs = [
        "src/chi_xp.sv",
        "src/chi_xp_channel.sv",
    ],
    deps = [
        ":chi_noc_flit_pkg",
        ":chi_noc_pkg",
        "//hardware/ip/chi:chi_link",
        "//hardware/ip/chi:chi_pkg",
        "//hardware/ip/common_cells:cc_rr_arb_tree",
    ],
)

# The reference topology. README.md quotes its NodeIDs, its zero-load latency
# and its saturation bound; //hardware/ip/chi_noc/nocgen:test asserts all three.
#
# How a device attaches to the mesh, and where the snoop's fabric header is put
# on and taken off. `top_module`, because it has no parameter that must be set,
# so the lint aspect can elaborate it on its own.
verilog_library(
    name = "chi_noc_device_port",
    srcs = ["src/chi_noc_device_port.sv"],
    top_module = "chi_noc_device_port",
    deps = [
        ":chi_noc_flit_pkg",
        ":chi_noc_pkg",
        "//hardware/ip/chi:chi_link",
        "//hardware/ip/chi:chi_pkg",
    ],
)

nocgen_topology(
    name = "mesh4x4",
    config = "//hardware/ip/chi_noc/nocgen:examples/mesh4x4.yml",
    deps = [":chi_xp"],
)
