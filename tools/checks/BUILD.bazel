# Checks that look at the source tree rather than at build outputs.
#
# Both are tagged no-sandbox, which is the same trade //tools/format:format_test
# makes and for the same reason: what they inspect is "every Python file" and
# "everything git tracks", and neither is a list of srcs. A list only ever holds
# what somebody remembered to add, which for a check is the failure mode that
# matters -- it looks green because it never looked.

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":defs.bzl", "MAX_FILE_BYTES")

# Reaching outside the sandbox, so: never cached, never sent to a worker.
#
# no-remote-exec is the one that keeps it off a worker, and it is the one that
# was missing. The other three describe caching and sandboxing and say nothing
# about where the action runs, so under --config=hetzner these were dispatched
# to Buildbarn and failed there with "is not the source tree -- the marker did
# not resolve out of the execroot".
#
# That is the right failure: remotely, runfiles are copies the worker
# materialised, so the marker resolves inside the execroot. Locally they are
# symlinks into the real tree, which is what workspace_root.sh needs. "Locally"
# in CI means the Actions runner, where actions/checkout has just produced a
# git tree -- so these still run on every push, just not on a worker.
_LOCAL = [
    "external",
    "no-cache",
    "no-remote-exec",
    "no-sandbox",
]

sh_test(
    name = "large_files_test",
    size = "small",
    srcs = ["large_files.sh"],
    args = [
        "$(rlocationpath //:MODULE.bazel)",
        str(MAX_FILE_BYTES),
    ],
    data = [
        "workspace_root.sh",
        "//:MODULE.bazel",
    ],
    tags = _LOCAL,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Three occurrences, two of them after the lesson was written down. A rule a
# person keeps being asked to remember is a rule that belongs in a test.
sh_test(
    name = "verilog_comments_test",
    size = "small",
    srcs = ["verilog_comments.sh"],
    args = ["$(rlocationpath //:MODULE.bazel)"],
    data = [
        "workspace_root.sh",
        "//:MODULE.bazel",
    ],
    tags = _LOCAL,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "ruff_check_test",
    size = "small",
    srcs = ["ruff_check.sh"],
    args = [
        "$(rlocationpath //:MODULE.bazel)",
        "$(rlocationpath @multitool//tools/ruff)",
    ],
    data = [
        "workspace_root.sh",
        "//:MODULE.bazel",
        "@multitool//tools/ruff",
    ],
    tags = _LOCAL,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
