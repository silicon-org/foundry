# firtool, the CIRCT compiler that turns the FIRRTL a Chisel generator emits into
# SystemVerilog. A build tool like the C compiler, so it lives here rather than
# beside the IP that happens to need it.
#
# Built from source, in //third_party/circt. It used to be a downloaded binary,
# which worked everywhere CIRCT publishes one -- and CIRCT publishes none for
# linux/arm64, in any release variant, so RTL could not be generated on the local
# cluster at all. Building it also puts the CIRCT libraries in the graph, which
# is what an FPGA transformation pass would link against.

package(default_visibility = ["//visibility:public"])

alias(
    name = "firtool",
    actual = "@circt//:firtool",
)
