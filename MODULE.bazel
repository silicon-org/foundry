# firtool, the CIRCT compiler that turns the FIRRTL the generator emits into
# SystemVerilog. Version 1.149.0 is not a choice: Chisel 7.13.0 records exactly
# that version in etc/circt.json and its own tests run against it.
#
# `firrtl-bin` rather than `circt-full`, which is the same binary plus a
# gigabyte of static libraries for linking against CIRCT.
#
# Note what is missing: CIRCT publishes no linux/arm64 binary. RTL generation
# therefore runs locally on a Mac or remotely on the x86 cluster, but not on the
# arm64 one without building CIRCT from source.
http_archive(
    name = "firtool_linux_x64",
    build_file = "//tools/firtool:firtool.BUILD.bazel",
    sha256 = "3b32374cf3fe364698d02439766b95ec085072f57d68f90e6b83212b7afdf54c",
    strip_prefix = "firtool-1.149.0",
    url = "https://github.com/llvm/circt/releases/download/firtool-1.149.0/firrtl-bin-linux-x64.tar.gz",
)

http_archive(
    name = "firtool_macos_arm64",
    build_file = "//tools/firtool:firtool.BUILD.bazel",
    sha256 = "74e6bf66bf7f99f7e733f84730bee64d6838b9c59e1c70381de3d163935f70d6",
    strip_prefix = "firtool-1.149.0",
    url = "https://github.com/llvm/circt/releases/download/firtool-1.149.0/firrtl-bin-macos-arm64.tar.gz",
)

# espresso, the logic minimiser Chisel folds decoder tables with. XiangShan asks
# for it by name -- EspressoMinimizer, not the pure-Scala fallback -- so without
# it elaboration stops partway with EspressoNotFoundException.
#
# Upstream ships a copy inside its resources and puts that directory on PATH. That
# copy is an x86-64 ELF binary, which is no use on a Mac and on no PATH at all
# once the resources are inside a jar.
#
# Built from source rather than downloaded, for the same reason Verilator is:
# thirty C files and no configure step cost nothing to compile, the compiler is
# the hermetic one, and it then works on every platform the toolchain targets --
# including linux/arm64, for which no binary is published.
#
# Pinned to a commit because the newest tag, v2.4, predates a restructuring of the
# source tree: at that tag espresso.h includes a port.h the tag does not ship.
http_archive(
    name = "espresso",
    build_file = "//tools/espresso:espresso.BUILD.bazel",
    sha256 = "666697ade8d385764de3e1a47ccb6778542e7de833f9e64fff5b54bd886a3072",
    strip_prefix = "espresso-0288253ca9459539d341bb1ada10406a74efc721",
    url = "https://github.com/chipsalliance/espresso/archive/0288253ca9459539d341bb1ada10406a74efc721.tar.gz",
)

