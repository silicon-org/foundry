load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

# The link layer, against its own mirror image, with no design in the build.
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

# The two protocol models against each other, with no RTL and no fabric. If they
# agree here they agree about CHI, and any later failure with a mesh between
# them is the mesh's.
cc_test(
    name = "chi_request_node_test",
    size = "small",
    srcs = ["chi_request_node_test.cc"],
    deps = [
        "//hardware/vip/chi:chi_home_node",
        "//hardware/vip/chi:chi_request_node",
        "//hardware/vip/common:memory",
    ],
)

cc_test(
    name = "chi_flit_test",
    size = "small",
    srcs = ["chi_flit_test.cc"],
    deps = ["//hardware/vip/chi:chi_flit"],
)

# The protocol model, with no RTL in the build at all.
cc_test(
    name = "chi_home_node_test",
    size = "small",
    srcs = ["chi_home_node_test.cc"],
    deps = [
        "//hardware/vip/chi:chi_home_node",
        "//hardware/vip/common:memory",
    ],
)

verilog_library(
    name = "chi_link_loopback_tb",
    srcs = ["chi_link_loopback_tb.sv"],
    hdrs = ["//hardware/vip/common:vip_dpi_svh"],
    top_module = "chi_link_loopback_tb",
    deps = ["//hardware/vip/chi/rtl:chi_link"],
)

verilator_cc_library(
    name = "chi_link_loopback_verilated",
    module = ":chi_link_loopback_tb",
    timing = True,
    vopts = [
        "-Wall",
        "-Wno-fatal",
        "-Wno-UNUSEDPARAM",
        # A testbench's reset is read both asynchronously, by the flops it
        # resets, and synchronously, by the checks that only apply once it is
        # released. In design code that mixture is a warning worth having.
        "-Wno-SYNCASYNCNET",
        # The assertions in the link layer are the test's verdict, so they have
        # to be compiled in.
        "--assert",
        # Verilator writes main() and the --timing loop, so no C++ lives here.
        "--main",
        # One default timescale for every module, so that a mixture of files
        # with and without a `timescale directive is not a warning about
        # something nobody chose.
        "--timescale",
        "1ns/1ps",
    ],
)

# The binary the cases share. A cc_binary rather than a cc_test, because it needs
# a `+case=` to do anything and a test that always fails is noise.
cc_binary(
    name = "chi_link_loopback",
    deps = [
        ":chi_link_loopback_verilated",
        "//hardware/vip/common:verilated_shims",
        "//hardware/vip/common:vip_dpi",
    ],
)

# One model, one case each. Separate targets rather than one run of everything,
# so a failure names the property that broke rather than the file it was in.
[cc_test(
    name = "chi_link_{}_test".format(case),
    size = "small",
    args = ["+case={}".format(case)],
    deps = [
        ":chi_link_loopback_verilated",
        "//hardware/vip/common:verilated_shims",
        "//hardware/vip/common:vip_dpi",
    ],
) for case in [
    "bringup",
    "transfer",
    "credit",
    "deactivate",
]]

# The negative cases. Each drives the pins with something no correct transmitter
# would produce; passing means the receiving channel failed to notice, and the
# expected text means it noticed for the right reason.
[sh_test(
    name = "chi_link_{}_test".format(case),
    size = "small",
    srcs = ["expect_failure.sh"],
    args = [
        "$(rootpath :chi_link_loopback)",
        expected,
        "+case={}".format(case),
    ],
    data = [":chi_link_loopback"],
) for case, expected in [
    ("rogue_overrun", "flit arrived with the buffer full"),
    ("rogue_before_run", "flit arrived with no L-Credit outstanding"),
]]

# The whole agent -- link, DPI boundary, C++ home node and the memory behind it
# -- with no design in the build. The seam the two tests either side of it
# cannot reach.
verilog_library(
    name = "chi_hn_agent_tb",
    srcs = ["chi_hn_agent_tb.sv"],
    hdrs = [
        "//hardware/vip/chi:chi_hn_dpi_svh",
        "//hardware/vip/common:vip_dpi_svh",
    ],
    top_module = "chi_hn_agent_tb",
    deps = ["//hardware/vip/chi/rtl:chi_hn_agent"],
)

verilator_cc_library(
    name = "chi_hn_agent_verilated",
    module = ":chi_hn_agent_tb",
    timing = True,
    vopts = [
        "-Wall",
        "-Wno-fatal",
        "-Wno-UNUSEDPARAM",
        "-Wno-SYNCASYNCNET",
        "--assert",
        "--main",
        "--timescale",
        "1ns/1ps",
    ],
)

[cc_test(
    name = "chi_hn_agent_{}_test".format(case),
    size = "small",
    args = ["+case={}".format(case)],
    deps = [
        ":chi_hn_agent_verilated",
        "//hardware/vip/chi:chi_hn_dpi",
        "//hardware/vip/common:verilated_shims",
        "//hardware/vip/common:vip_dpi",
    ],
) for case in [
    "read_line",
    "write_word",
]]
