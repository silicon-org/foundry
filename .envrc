# Puts the Bazel-pinned CLI tools (tofu, talosctl, kubectl, helm, flux, ...) on
# PATH so interactive use matches exactly what the build uses.
#
#   bazel run //tools:bazel_env
#   direnv allow
#
# See https://direnv.net/docs/hook.html to enable the shell hook once per user.

watch_file bazel-out/bazel_env-opt/bin/tools/bazel_env/bin
PATH_add bazel-out/bazel_env-opt/bin/tools/bazel_env/bin
if [[ ! -d bazel-out/bazel_env-opt/bin/tools/bazel_env/bin ]]; then
  log_error "ERROR[bazel_env.bzl]: run 'bazel run //tools:bazel_env' to generate the tool PATH"
fi
