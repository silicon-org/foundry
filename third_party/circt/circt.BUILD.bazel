# The pipeline firtool runs, as a library. This is the seam loom will sit
# against: the passes it would insert are the ones this file schedules.
#
# CMake calls this CIRCTFirtool and the binary firtool, which is fine for CMake
# and not for Bazel on a Mac: each C++ target emits a module map named after it,
# so "Firtool" and "firtool" are the same file on a case-insensitive filesystem
# and the sandbox refuses to place the second one. The same hazard that made
# YunSuan need a patch -- see //MODULE.bazel. Named for what it is instead.
cc_library(
    name = "FirtoolPipeline",
    srcs = ["lib/Firtool/Firtool.cpp"],
    hdrs = ["include/circt/Firtool/Firtool.h"],
