# Cluster access over the tailnet, committed because it contains no secret.
#
# Every other kubeconfig in this repository is generated and gitignored, because
# it carries the cluster CA and a client certificate. This one carries neither:
# the server is the Tailscale operator's API server proxy, which authenticates
# the caller by their tailnet identity and impersonates it into Kubernetes. The
# `token: unused` below is a placeholder that kubectl requires and the proxy
# ignores -- it is not a credential, and `tailscale configure kubeconfig` writes
# the same literal string.
#
# That is the point of committing it. There is no per-machine setup: being on
# the tailnet is the whole requirement, and authorisation is a ClusterRoleBinding
# against a named user (see infra/platform/tailscale/rbac.yaml) rather than
# possession of a file.
#
# It follows that this file grants nobody anything. Someone off the tailnet
# cannot resolve the name, and someone on it gets exactly the RBAC their
# identity has.
apiVersion: v1
kind: Config
clusters:
  - name: foundry
    cluster:
      server: https://tailscale-operator.pogona-gila.ts.net
contexts:
  - name: foundry
    context:
      cluster: foundry
      user: tailscale
current-context: foundry
users:
  - name: tailscale
    user:
      token: unused
