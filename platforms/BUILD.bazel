package(default_visibility = ["//visibility:public"])

# The execution platforms for remote actions.
#
# exec_properties are what Bazel sends to the scheduler, and the scheduler
# matches them against what a worker advertises in its `platform.properties`.
# They have to agree exactly: a mismatch does not fall back to local execution,
# it queues until platformQueueWithNoWorkersTimeout expires. See
# infra/platform/buildbarn/config/worker.jsonnet for the other half.
#
# Two of them, because the two clusters differ in architecture and there is no
# way to paper over that: an action built for one will not run on the other.
# The local cluster is Talos in Docker on an Apple Silicon Mac, so it is arm64.
# The cloud cluster is Hetzner, which is x86 -- not by preference but by
# availability, since Hetzner's arm64 line was out of stock everywhere when it
# was built. See infra/doc/architecture.md.

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    exec_properties = {
        "OSFamily": "linux",
        "ISA": "arm64",
        # The size class a worker must advertise to receive this action. Every
        # action asks for "small" unless a target overrides it, because almost
        # every action is small: a representative CI run served 6928 from cache
        # and executed three.
        "size": "small",
    },
)

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "OSFamily": "linux",
        "ISA": "amd64",
        # See linux_arm64. A target that needs more says so with
        # exec_properties = {"size": "large"}, which overrides this one key and
        # sends it to a worker that only exists while such work is queued.
        "size": "small",
    },
)
