# Verification IP that no protocol owns.
#
# See //hardware/vip/README.md for the layering. Everything here is shared by
# the CHI, AXI and TileLink agents, and anything that is not shared belongs one
# level down.

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# A link stub for the one symbol Verilator's runtime wants. The evaluation loop
# that used to live here is now generated by `--main`.
#
# Names no Verilated runtime on purpose: rules_verilator builds a separate one
# for timing-enabled models, and depending on either would drag the wrong one
# into half the testbenches.
cc_library(
    name = "verilated_shims",
    srcs = ["verilated_shims.cc"],
)

# The backing store every agent shares, and the watchpoints that turn a write
# into a test's verdict.
cc_library(
    name = "memory",
    srcs = ["memory.cc"],
    hdrs = ["memory.h"],
)

cc_library(
    name = "logging",
    srcs = ["logging.cc"],
    hdrs = ["logging.h"],
    deps = ["@spdlog"],
)

# How a C++ model ends a SystemVerilog simulation, and the DPI declaration a
# testbench needs to poll it.
cc_library(
    name = "test_control",
    srcs = ["test_control.cc"],
    hdrs = ["test_control.h"],
    deps = [":logging"],
)

# The memory a testbench sets up, and how it knows it is finished. The whole of
# a test's setup crosses here, so that the test is the SystemVerilog.
cc_library(
    name = "vip_dpi",
    srcs = ["vip_dpi.cc"],
    hdrs = ["vip_dpi.h"],
    deps = [
        ":logging",
        ":memory",
        ":test_control",
    ],
)

filegroup(
    name = "vip_dpi_svh",
    srcs = ["vip_dpi.svh"],
)
